{
  "name": "official-account-push",
  "version": "2.2.0",
  "description": "AI Agent 公众号内容助手：自然语言对话 → 爬取热点 → AI生成文章 → 推送公众号",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "start": "node src/main.js --mode=websocket",
    "once": "node src/main.js --mode=once",
    "dry-run": "node src/main.js --mode=once --dry-run",
    "scheduler": "node src/main.js --mode=scheduler",
    "server": "node src/main.js --mode=server",
    "web": "node src/main.js --mode=web",
    "dev": "concurrently -k -n web,ui -c green,cyan \"node --watch src/main.js --mode=web\" \"vite --config frontend/vite.config.js\"",
    "build:web": "vite build --config frontend/vite.config.js",
    "score": "node scripts/score.js",
    "test": "node --test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@larksuiteoapi/node-sdk": "^1.60.0",
    "axios": "^1.7.0",
    "cheerio": "1.0.0-rc.12",
    "dotenv": "^16.4.0",
    "node-cron": "^3.0.3",
    "openai": "^4.47.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.2.2",
    "vite": "^5.4.21"
  }
}
