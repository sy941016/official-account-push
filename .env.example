# ============================================================
# 这是配置模板，不含任何真实密钥，会随代码一起提交到 git。
#
# 新机器上的用法：
#   cp .env.example .env    然后填入下面的真实值
#
# 真正的 .env 已被 .gitignore 忽略，永远不会进版本库。
# 换电脑时 .env 不会跟着来 —— 密钥要另外找地方保管（密码管理器等）。
#
# 每一项具体去哪申请，见 README 的「如何获取各项凭证」一节。
# ============================================================

# ---------- AI 提供商（必填其一）----------
# 可选：claude | openai | doubao
AI_PROVIDER=claude

# provider=claude 时必填
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# provider=openai 时必填
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# provider=doubao 时必填
DOUBAO_API_KEY=
DOUBAO_MODEL=doubao-pro-1-5
# 豆包接口地址，一般不用改；用自建/代理网关时才需要
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 单次 AI 请求超时（毫秒）
# 用推理模型（如 doubao-seed-evolving）时要调大到 600000：
# 这类模型吞吐只有 20~25 token/秒，写一篇完整文章会超过 180 秒，
# 表现为 "timeout of 180000ms exceeded" 然后反复重试。
AI_REQUEST_TIMEOUT_MS=180000
# AI 调用失败重试次数（只重试网络错误 / 429 / 5xx）
AI_MAX_RETRIES=3
# 采样惩罚：压低高频"保险用词"的重复率，是降低文本可预测性最直接的两个旋钮（-2 ~ 2）。
# 只对 openai / doubao 生效，claude 协议不支持这两个参数。
AI_FREQUENCY_PENALTY=0.4
AI_PRESENCE_PENALTY=0.3

# ---------- 微信公众号（不配则跳过发布）----------
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ---------- 飞书（不配则跳过飞书通知/机器人）----------
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=
# HTTP 回调模式（npm run server）强烈建议配置，否则事件接口无鉴权
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# ---------- 爬虫 ----------
# 配置 Cookie 可大幅提升爬取成功率
WEIBO_COOKIE=
DOUYIN_COOKIE=
# 爬虫请求超时（毫秒）
CRAWLER_TIMEOUT_MS=15000

# ---------- 运行参数 ----------
# 默认每 2 小时执行一次
CRON_SCHEDULE=0 */2 * * *
# 每次处理热点数量
TOPICS_PER_RUN=3
# 两条话题之间的等待秒数，避免触发平台频控
TOPIC_INTERVAL_SECONDS=5
# 默认文章风格：default（爆款）| jaychou（诗意叙事）| sharp（观点犀利）| healing（治愈温暖）| knowledge（干货科普）
ARTICLE_STYLE=default

# ---------- 反 AI 检测（腾讯朱雀这类检测器的"人工特征占比"）----------
# 原理：检测器看的是统计分布（句长是否均匀、段落是否等长、套话词频），
# 不是字面用词，所以换同义词没用。下面几项控制生成节奏和后处理力度。
#
# 采样温度：反检测靠的是句式多样性，温度太低会让表达更"标准"、更像 AI（0 ~ 2）
ARTICLE_TEMPERATURE=0.9
# 单次生成的最大输出 token。文章越长（含内联样式 HTML）越容易截断。
# 推理模型尤其要注意：reasoning_tokens 也计入这个额度，思维链越长留给正文的越少，
# 撞上限会报 "模型输出被截断"，该选题被跳过（不会发半成品）。
ARTICLE_MAX_TOKENS=8192
# 生成后是否做"去 AI 味"后处理（套话替换 + 长段落打散）
ARTICLE_HUMANIZE=true
# 人味自检分低于该值时，带着问题清单重写；设为 0 则从不重写（0 ~ 100）
ARTICLE_MIN_HUMAN_SCORE=70
# 最多重写几轮。每轮都要重新调一次模型，这是唯一的额外成本；0 = 关闭重写
ARTICLE_REWRITE_ROUNDS=1
# 单篇文章的**总**时间预算（毫秒），覆盖"重试 + 重写轮次"全部环节。
# AI_REQUEST_TIMEOUT_MS 只是**单次请求**超时，它 ×(重试次数+1)×(重写轮次+1) 才是单篇的最坏耗时——
# 默认 600s 时这个乘积是 80 分钟，而调度周期只有 12 小时、流水线还是串行的。
# 超预算就不再开新一轮重写，手里已有的版本照常返回（不会发半成品，也不会无限等）。
ARTICLE_TOTAL_BUDGET_MS=900000

# 飞书 HTTP 回调服务端口
LOCAL_SERVER_PORT=8080
# debug | info | warn | error
LOG_LEVEL=info
# HTTP 请求体大小上限（字节），防止超大请求打爆内存
MAX_BODY_BYTES=1000000

# ---------- 日志 ----------
# 单个日志文件大小上限（MB），超出自动轮转为 YYYY-MM-DD.N.log
LOG_MAX_SIZE_MB=10
# 日志文件保留份数
LOG_MAX_FILES=7

# ---------- Agent ----------
# Agent 最大推理轮次
AGENT_MAX_ITERATIONS=10
# 每个会话保留的消息数（建议 >= 8，过小会截断工具调用上下文）
AGENT_MEMORY_SIZE=20
# 单条工具结果写入上下文时的截断长度
AGENT_MAX_TOOL_RESULT_CHARS=8000
# Web 聊天服务端口
AGENT_WEB_PORT=3000
# Web 服务允许的跨域来源，默认 *；仅本机使用时建议改为 http://localhost:3000
WEB_CORS_ORIGIN=*
# 设置后调用 /api/* 需带 header: x-web-token；留空表示不校验
WEB_ACCESS_TOKEN=

# ---------- Web 登录页 ----------
# 账号密码：两者**同时**配置才启用登录页（打开 http://localhost:3000 先登录再进助手页）。
# 都留空 = 不启用登录，行为与加登录之前完全一致。
# 注意：这是唯一的口令来源，改完要重启服务才生效（config 在模块加载时读 env）。
WEB_LOGIN_USER=
WEB_LOGIN_PASSWORD=
# 登录有效期（小时），默认 12；下限 5 分钟
WEB_SESSION_TTL_HOURS=12
# 会话 cookie 的签名密钥。留空则由账号密码派生 ——
# 省掉一个要保管的密钥，且改密码会让所有旧会话自动失效。
# 把服务暴露到公网时请显式填一个随机串（例如 `openssl rand -hex 32`）。
WEB_SESSION_SECRET=

# ---------- 图片服务（按文章内容自动搜图配图）----------
# 可选：unsplash | pexels | none
#   none = 关闭配图，正文无图，封面退回"素材库第一张"的老方案
# 不填 Key 也会自动跳过配图，不影响文章发布。
IMAGE_PROVIDER=unsplash
# IMAGE_PROVIDER=unsplash 时必填（https://unsplash.com/developers）
UNSPLASH_ACCESS_KEY=
# IMAGE_PROVIDER=pexels 时必填（https://www.pexels.com/api/）
PEXELS_API_KEY=
# 每篇文章插入正文的配图数量，0 = 不插图
IMAGE_COUNT=2
# 是否把第一张配图同时用作封面。
# 注意：微信要求封面必须是永久素材的 media_id，开启后会往你的公众号素材库上传图片，
# 会占用素材库配额（上限约 5000 张）。不想占配额就设为 false，封面仍取素材库第一张。
IMAGE_AS_COVER=true
# 图库搜索/下载超时（毫秒）
IMAGE_REQUEST_TIMEOUT_MS=15000

# ============================================================
# 以下是进阶项，一般不需要动。默认值已写在 config/index.js 里，
# 只有想把缓存/日志挪到别处时才需要取消注释。
# ============================================================
# 已处理话题去重缓存文件
# CACHE_FILE=.cache/processed_topics.json
# 微信 AccessToken 缓存文件
# WECHAT_TOKEN_CACHE_FILE=.cache/wechat_token.json
# 日志目录
# LOG_DIR=logs
